 package com.bugzero.meety.ui.team
 
+import androidx.compose.runtime.getValue
+import androidx.compose.runtime.mutableStateOf
+import androidx.compose.runtime.setValue
 import androidx.lifecycle.ViewModel
+import com.google.firebase.Timestamp
+import com.google.firebase.auth.FirebaseAuth
+import com.google.firebase.firestore.FirebaseFirestore
 
 class TeamViewModel : ViewModel() {
-    // TODO: C 담당 - 내 팀, 마이페이지, 모임 생성 로직 구현
-    // 매칭 성사 로직 관리
+
+    private val auth = FirebaseAuth.getInstance()
+    private val db = FirebaseFirestore.getInstance()
+
+    // 로딩 상태
+    var isLoading by mutableStateOf(false)
+        private set
+
+    // 성공 시 생성된 teamId 저장
+    var createdTeamId by mutableStateOf("")
+        private set
+
+    // 에러 메시지 저장
+    var errorMessage by mutableStateOf("")
+        private set
+
+    // 팀 생성 성공 여부
+    var isCreateSuccess by mutableStateOf(false)
+        private set
+
+    /**
+     * 팀 만들기
+     * - users/{userId}에서 mbti, profileImages[0] 읽기
+     * - teams 새 문서 생성
+     * - users/{userId}.teamId 업데이트
+     */
+    fun createTeam() {
+        val currentUserId = auth.currentUser?.uid
+
+        if (currentUserId == null) {
+            errorMessage = "로그인 유저가 없습니다."
+            isCreateSuccess = false
+            return
+        }
+
+        isLoading = true
+        errorMessage = ""
+        isCreateSuccess = false
+        createdTeamId = ""
+
+        db.collection("users")
+            .document(currentUserId)
+            .get()
+            .addOnSuccessListener { userDoc ->
+                val mbti = userDoc.getString("mbti") ?: ""
+
+                val userProfileImages =
+                    userDoc.get("profileImages") as? List<String> ?: emptyList()
+
+                val mainProfileImage =
+                    if (userProfileImages.isNotEmpty()) userProfileImages[0] else ""
+
+                val teamRef = db.collection("teams").document()
+                val teamId = teamRef.id
+
+                val teamData = hashMapOf(
+                    "leaderId" to currentUserId,
+                    "memberIds" to listOf(currentUserId),
+                    "mbtiTags" to listOf(mbti),
+                    "profileImages" to listOf(mainProfileImage),
+                    "teamProfileImage" to "",
+                    "status" to "active",
+                    "createdAt" to Timestamp.now()
+                )
+
+                teamRef.set(teamData)
+                    .addOnSuccessListener {
+                        db.collection("users")
+                            .document(currentUserId)
+                            .update("teamId", teamId)
+                            .addOnSuccessListener {
+                                isLoading = false
+                                isCreateSuccess = true
+                                createdTeamId = teamId
+                            }
+                            .addOnFailureListener { e ->
+                                isLoading = false
+                                isCreateSuccess = false
+                                errorMessage = e.message ?: "users 팀 ID 업데이트에 실패했습니다."
+                            }
+                    }
+                    .addOnFailureListener { e ->
+                        isLoading = false
+                        isCreateSuccess = false
+                        errorMessage = e.message ?: "teams 생성에 실패했습니다."
+                    }
+            }
+            .addOnFailureListener { e ->
+                isLoading = false
+                isCreateSuccess = false
+                errorMessage = e.message ?: "유저 정보를 불러오지 못했습니다."
+            }
+    }
+
+    /**
+     * 상태 초기화
+     * - 화면 이동 후 성공 상태/에러 상태를 비우고 싶을 때 사용
+     */
+    fun clearState() {
+        isLoading = false
+        isCreateSuccess = false
+        createdTeamId = ""
+        errorMessage = ""
+    }
 }
