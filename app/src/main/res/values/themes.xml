<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- 기본 앱 테마 (기존 그대로) -->
    <style name="Theme.Meetycompose" parent="android:Theme.Material.Light.NoActionBar" />

    <!-- 시스템 스플래시 화면 테마 (Android 12+) -->
    <style name="Theme.Meetycompose.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#9333EA</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_meety_splash</item>
        <!-- 아이콘 뒤에 OS가 자동으로 배경원 추가하지 않도록 투명 처리 -->
        <item name="windowSplashScreenIconBackgroundColor">@android:color/transparent</item>
        <item name="postSplashScreenTheme">@style/Theme.Meetycompose</item>
    </style>


</resources>