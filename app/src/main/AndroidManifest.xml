<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 네트워크 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 알림 (Android 13 / API 33+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 화상/음성 통화 -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- 수신 전화 알림: 잠금화면/화면꺼짐 상태에서 전체화면 표시 (CallStyle 필수) -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <!-- Bluetooth 오디오 장치 (이어폰 등) -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- 수락 버튼 → Foreground Service 경유로 앱 실행 (Android 10+ 백그라운드 Activity 제한 우회) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_PHONE_CALL" />

    <!-- 카메라/마이크 선택 사항 (없어도 앱 실행 가능) -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <application
        android:name=".MeetyApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Meetycompose">
        <!-- FCM 메시지 수신 서비스 -->
        <service
            android:name="com.bugzero.meety.MyFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- 전화 알림 수락/거절 버튼 처리 -->
        <receiver
            android:name="com.bugzero.meety.CallActionReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.bugzero.meety.ACTION_ACCEPT_CALL" />
                <action android:name="com.bugzero.meety.ACTION_DECLINE_CALL" />
            </intent-filter>
        </receiver>

        <!-- 수락 시 백그라운드에서 Activity 시작을 위한 Foreground Service -->
        <service
            android:name="com.bugzero.meety.CallLaunchService"
            android:exported="false"
            android:foregroundServiceType="phoneCall" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Meetycompose.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>